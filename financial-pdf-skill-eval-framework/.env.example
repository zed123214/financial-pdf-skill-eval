# Volcengine LAS credentials. Only required when ALLOW_REAL_LAS=1.
LAS_API_KEY=
LAS_REGION=cn-beijing

# Opt-in to actually calling LAS (costs money). Default off.
ALLOW_REAL_LAS=0

# Opt-in to real OpenClaw integration (currently unverified). Default off.
ALLOW_REAL_OPENCLAW=0

# Optional: LLM-as-a-Judge (configs/judge.yaml mode=live). Default off.
JUDGE_API_KEY=
